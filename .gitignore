node_modules/

# scraper/output/ is deliberately NOT ignored.
#
# The container these runs happen in is temporary: when a session ends, anything
# not pushed is gone. That meant a finished sweep could be lost simply because
# nobody asked for the file before the session closed — the run wasted, not
# because it failed, but because it was never collected.
#
# Committing runs also means a future session can read an earlier sweep to
# diagnose a change, rather than her having to find and re-upload "the CSV from
# that date" by hand.
#
# Size is not a reason to reconsider: a 21-venue run is ~500 KB of text today
# and ~120 KB once summaries are compressed, and git stores text well.

# Compressor working files — regenerated by the commands that use them, and
# meaningless once the step they belong to has finished. The RESULTS
# (sweep_compressed.csv, and the run directories themselves) are deliberately
# committed; these are the scratch in between.
scraper/output/**/.compress_done.json
scraper/output/eval_pending.json
scraper/output/eval_answers.json
